# Copie para .env (`cp .env.example .env`). O .env fica fora do git.
# Um único arquivo serve ao Docker Compose, à API (NestJS) e ao front (Vite lê as variáveis VITE_*).
# Os valores abaixo são de DESENVOLVIMENTO. Em produção, tudo isso vem de Kubernetes Secrets.

# ──────────────────────────────────────────────────────────────────────────────
# Docker Compose (docker-compose.yml). Todos têm padrão; só defina para sobrescrever.
# ──────────────────────────────────────────────────────────────────────────────
# ZITADEL_VERSION=v4.19.5
# POSTGRES_IMAGE=postgres:17.10-alpine
# TRAEFIK_IMAGE=traefik:v3.7.7
# MAILPIT_IMAGE=axllent/mailpit:v1.31.6
# POSTGRES_PORT=5434
# POSTGRES_ADMIN_PASSWORD=postgres
# ZITADEL_DOMAIN=localhost
# ZITADEL_EXTERNALPORT=8080
# ZITADEL_MASTERKEY=MasterkeyNeedsToHave32Characters        # exatamente 32 caracteres; não muda depois da 1ª subida
# LOGIN_SESSION_COOKIE_SECRET=SessionCookieSecretNeedsAtLeast32Chars   # mínimo 32; `openssl rand -base64 32`
# ZITADEL_ORG_NAME=Missão Salesiana de Mato Grosso
# ZITADEL_ADMIN_USERNAME=zitadel-admin                     # login: zitadel-admin@missão-salesiana-de-mato-grosso.localhost
# ZITADEL_ADMIN_PASSWORD=Password1!

# ──────────────────────────────────────────────────────────────────────────────
# API (apps/api)
# ──────────────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
LOG_LEVEL=debug
# Só na imagem de produção (Dockerfile): pasta do build do front servido pela API. Em dev, o Vite serve o front.
# WEB_DIST_PATH=

# PostgreSQL (T03). O role helpdesk é criado por deploy/local/postgres/init.sql.
DATABASE_URL=postgresql://helpdesk:helpdesk@127.0.0.1:5434/helpdesk?schema=public
# Banco dos testes e2e (criado por init.sql; o globalSetup do Vitest migra). Só defina para sobrescrever.
# DATABASE_URL_TEST=postgresql://helpdesk:helpdesk@127.0.0.1:5434/helpdesk_test?schema=public

# Zitadel (spec T04–T05). PROJECT_ID e ORG_ID saem do console após criar o projeto "Help Desk".
ZITADEL_ISSUER=http://localhost:8080
ZITADEL_PROJECT_ID=
ZITADEL_ORG_ID=
AUTH_CLOCK_TOLERANCE_SECONDS=60
AUTH_CACHE_TTL_SECONDS=60

# E-mail de saída (T14). Em dev aponta para o Mailpit; em produção, smtp.gmail.com:587 com senha de app.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Suporte MSMT <suporte@missaosalesiana.org.br>"
PORTAL_URL=http://localhost:5173
# Domínio do Message-ID dos e-mails enviados (<tk-...@domínio>), usado no threading das respostas (T21).
MAIL_MESSAGE_ID_DOMAIN=suporte.msmt.org.br
# Cron da outbox (1 min). Desligado nos testes, que chamam processOutbox() direto.
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_BATCH_SIZE=20
# Tentativas antes de desistir (backoff de 1, 2, 4, 8 e 16 min). Resposta SMTP 5xx desiste na hora.
NOTIFICATIONS_MAX_ATTEMPTS=6
# Anexos da mensagem vão no e-mail até este total (bytes); acima, só os nomes.
NOTIFICATIONS_MAX_ATTACHMENT_BYTES=20971520

# E-mail de entrada (T21). `folder` processa arquivos .eml em MAILBOX_FOLDER_PATH (relativo a apps/api);
# `imap` lê a caixa real. Cron de 1 min ligado por INBOUND_ENABLED.
INBOUND_ENABLED=true
MAILBOX_DRIVER=folder
MAILBOX_FOLDER_PATH=./.inbox
MAILBOX_HOST=imap.gmail.com
MAILBOX_PORT=993
MAILBOX_USER=
MAILBOX_PASSWORD=
# Hora da virada, ISO 8601 com fuso (ex.: 2026-10-27T07:15:00-04:00). Vazio = só e-mails que chegarem daqui em diante.
MAILBOX_START_SINCE=
MAILBOX_BATCH_SIZE=50
# Rótulos aplicados no Gmail: <prefixo>/processado, /descartado, /erro. O e-mail continua na INBOX.
MAILBOX_LABEL_PREFIX=helpdesk
INTERNAL_EMAIL_DOMAINS=missaosalesiana.org.br
INBOUND_RATE_LIMIT_PER_HOUR=20

# Anexos (T13). `local` grava em STORAGE_LOCAL_PATH; `s3` usa o Object Storage da Magalu.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=
S3_REGION=br-se1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# Front (apps/web). Só variáveis com prefixo VITE_ chegam ao browser.
# ──────────────────────────────────────────────────────────────────────────────
VITE_ZITADEL_AUTHORITY=http://localhost:8080
VITE_ZITADEL_CLIENT_ID=
VITE_ZITADEL_PROJECT_ID=
